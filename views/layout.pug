doctype html
include includes/mixins
html
  head
    block head
      meta(charset='utf-8')
      meta(http-equiv='x-ua-compatible', content='ie=edge')
      meta(name='viewport', content='width=device-width, initial-scale=1')
      title= title
      link(rel='stylesheet', href='/css/bootstrap.css')
      link(rel='stylesheet', href='/css/waip.css')
      link(rel='stylesheet', href='/css/bootstrap-icons.min.css')
      script(src='/js/jquery.min.js')
      script(src='/js/bootstrap.bundle.min.js')
      script(src='/js/session_keepalive.js')
  body
    include includes/header
    block content
    include includes/footer

    //- Cookie-Hinweis: Es gibt nur technisch notwendige Cookies, eine Einwilligung ist nicht nötig
    //- (§ 25 Abs. 2 Nr. 2 TDDDG). Der Hinweis ist reine Information und entfällt auf den
    //- Monitor-Ansichten (/waip, /dbrd), die dort per leerem Block überschreiben.
    block cookie_hinweis
      link(rel='stylesheet', href='/css/cookieconsent.min.css')
      script(src='/js/cookieconsent.min.js')
      script.
        window.addEventListener("load", function(){
          window.cookieconsent.initialise({
            "palette": {
              "popup": {
                "background": "#3c404d",
                "text": "#d6d6d6"
              },
              "button": {
                "background": "#8bed4f"
              }
            },
            "content": {
              "message": "Wachalarm-IP-Web verwendet nur technisch notwendige Cookies, z. B. für die Anmeldung. Cookies zu Werbe- oder Analysezwecken werden nicht verwendet.",
              "dismiss": "Verstanden",
              "link": "Datenschutzerklärung",
              "href": "/datenschutz",
              "target": "_self"
            },
            "showLink": true
          })
        });
