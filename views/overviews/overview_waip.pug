extends ../layout

//- Auswahlliste für einen Bereichstyp (leitstelle, wache, traeger, kreis)
mixin auswahl(farbe, typ, text)
  .dropdown.mt-auto
    button.btn.dropdown-toggle(class='btn-' + farbe, type='button' data-bs-toggle='dropdown' aria-expanded='false')= text
    .dropdown-menu(style='z-index: 2001; max-height: 50vh; overflow-y: auto')
      each item in list_wachen
        if item.typ == typ
          a.dropdown-item(href='/waip/'+ item.nr)= item.name

block content
  main(role='main')
    .container
      +seitenkopf('Alarmmonitor', 'Wählen Sie aus, welche Wachalarme im Vollbild angezeigt werden sollen.', 'bi-display')
      // Freitextsuche
      .position-relative.mb-4
        .input-group.input-group-lg
          span.input-group-text
            i.bi.bi-search(aria-hidden='true')
          input#searchWache.form-control(type='text' placeholder='Name oder Nummer suchen …' aria-label='Alarmmonitor suchen' autocomplete='off')
        ul#searchResults.list-group.position-absolute.w-100.mt-1.shadow(role='listbox' style='z-index:2000; max-height:300px; overflow-y:auto; display:none')
      .row.g-4
        .col-12.col-lg-7
          +kachel('Alle Wachalarme', 'success', 'bi-collection')
            p.card-text Zeigt Ihnen alle Wachalarme der im System hinterlegten Wachen an.
            p.card-text.text-body-secondary.small Wollen Sie nur Alarme für einen bestimmten Bereich sehen, wählen Sie bitte einen Alarmmonitor aus den Listen aus.
            a.btn.btn-success.mt-auto.align-self-start(href='/waip/0' role='button')
              | Alle Wachalarme anzeigen
              i.bi.bi-arrow-right.ms-2(aria-hidden='true')
        .col-12.col-lg-5
          +kachel('Leitstelle', 'warning', 'bi-broadcast')
            p.card-text Zeigt alle Wachalarme eines Leitstellenbereichs an.
            +auswahl('warning', 'leitstelle', 'Leitstelle auswählen')
        .col-12.col-md-4
          +kachel('Wache', 'info', 'bi-building')
            p.card-text Zeigt den Wachalarm einer einzelnen Wache (z.B. Feuerwache, Rettungswache etc.) an.
            +auswahl('info', 'wache', 'Wache auswählen')
        .col-12.col-md-4
          +kachel('Aufgabenträger', 'info', 'bi-bank')
            p.card-text Zeigt alle Wachalarme der Wachen eines Aufgabenträgers (Amt, amtsfreie Gemeinde, Stadt) an.
            +auswahl('info', 'traeger', 'Träger auswählen')
        .col-12.col-md-4
          +kachel('Kreis', 'info', 'bi-map')
            p.card-text Zeigt alle Wachalarme des gesamten Kreises (in Abhängigkeit der freigeschalteten Wachen) an.
            +auswahl('info', 'kreis', 'Kreis auswählen')
      // Optionen für den anschließend gewählten Alarmmonitor
      .card.border-0.mt-4.mb-4
        .card-body
          h2.h5.card-title.d-flex.align-items-center.gap-2
            i.bi.bi-sliders(aria-hidden='true')
            span Optionen
          p.card-text.text-body-secondary.small Markieren Sie die gewünschten Optionen und wählen Sie anschließend den Alarmmonitor aus.
          .form-check.form-switch.mb-2
            input#rmldOff.form-check-input(type='checkbox' role='switch')
            label.form-check-label(for='rmldOff') Rückmeldungen im Alarmmonitor ausblenden
          .form-check.form-switch.mb-2
            input#soundOff.form-check-input(type='checkbox' role='switch')
            label.form-check-label(for='soundOff') Hinweise zur Audioausgabe deaktivieren (z.B. wenn kein Lautsprecher angeschlossen ist)
          .form-check.form-switch
            input#animOff.form-check-input(type='checkbox' role='switch')
            label.form-check-label(for='animOff') Animationen reduzieren (für leistungsschwache Geräte, z.B. Raspberry Pi 3)
          if widgets_wetter_verfuegbar
            .form-check.form-switch.mt-2
              //- Standard an (WIDGET_WETTER_STANDARD): Schalter blendet aus, sonst blendet er ein
              input#wetterSchalter.form-check-input(type='checkbox' role='switch' data-wert=(widgets_wetter_standard ? 'off' : 'on'))
              label.form-check-label(for='wetterSchalter')= widgets_wetter_standard ? 'Wetter und Unwetterwarnungen im Standby ausblenden' : 'Wetter und Unwetterwarnungen im Standby anzeigen (auch ohne Anmeldung)'
    // Client-seitige Suchlogik + rmld=off Handling
    script.
      (function(){
        var data = !{JSON.stringify(list_wachen || [])};
        var input = document.getElementById('searchWache');
        var list = document.getElementById('searchResults');
        var rmldToggle = document.getElementById('rmldOff');
        var soundToggle = document.getElementById('soundOff');
        var animToggle = document.getElementById('animOff');
        var wetterToggle = document.getElementById('wetterSchalter');
        if(!input || !list) return;
        function sanitize(str){return String(str).replace(/[&<>"']/g,function(c){return({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;','\'':'&#39;'}[c]);});}
        function buildUrl(base){
          var params = [];
          if(rmldToggle && rmldToggle.checked){ params.push('rmld=off'); }
          if(soundToggle && soundToggle.checked){ params.push('sound=off'); }
          if(animToggle && animToggle.checked){ params.push('anim=off'); }
          if(wetterToggle && wetterToggle.checked){ params.push('wetter=' + wetterToggle.getAttribute('data-wert')); }
          if(!params.length) return base;
          return base + (base.indexOf('?')===-1?'?':'&') + params.join('&');
        }
        function render(results){
          list.innerHTML='';
          if(!results.length){ list.style.display='none'; return; }
            results.forEach(function(item){
              var li = document.createElement('li');
              li.className = 'list-group-item list-group-item-action';
              li.setAttribute('role','option');
              li.innerHTML = '<strong>'+ sanitize(item.name) + '</strong> <small class="text-muted">(' + sanitize(item.nr) + ', ' + sanitize(item.typ) + ')</small>';
              li.addEventListener('click', function(){ window.location.href = buildUrl('/waip/' + item.nr); });
              list.appendChild(li);
            });
          list.style.display='block';
        }
        input.addEventListener('keyup', function(){
          var q = input.value.trim().toLowerCase();
          if(!q){ list.style.display='none'; list.innerHTML=''; return; }
          var filtered = data.filter(function(item){
            var name = (item.name||'').toLowerCase();
            var nr = String(item.nr||'').toLowerCase();
            return name.indexOf(q) > -1 || nr.indexOf(q) > -1;
          }).slice(0,50);
          render(filtered);
        });
        document.addEventListener('click', function(e){
          if(!list.contains(e.target) && e.target !== input){ list.style.display='none'; }
        });
        // Links der Karten / Dropdowns dynamisch anreichern
        document.querySelectorAll('a[href^="/waip/"]').forEach(function(a){
          a.addEventListener('click', function(ev){
            if((rmldToggle && rmldToggle.checked) || (soundToggle && soundToggle.checked) || (animToggle && animToggle.checked) || (wetterToggle && wetterToggle.checked)){
              ev.preventDefault();
              var url = buildUrl(a.getAttribute('href'));
              window.location.href = url;
            }
          });
        });
      })();
