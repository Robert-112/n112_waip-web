extends ../layout

block content
  main(role='main')
    .container
      .row
        .col-12.p-3
          .card.bg-dark
            .card-body.text-muted.text-center
              h3 Alarmmonitor - Auswahl
        .col-12
          div.border-top.m-3
      // Eingefügte Freitextsuche
      .row.mt-2
        .col-12.px-3
          .form-group.position-relative
            input#searchWache.form-control.form-control-lg(type='text' placeholder='Suche nach einem Wachennamen oder einer Nummer...')
            ul#searchResults.list-group.position-absolute.w-100.mt-1(role='listbox' style='z-index:2000; max-height:300px; overflow-y:auto; display:none')
        .col-12
          div.border-top.mx-3.my-2
      .row 
        .col-12.col-md-7.d-flex.align-self-stretch.p-3
          .card.border-success.w-100.h-100
            .card-header
              h2.text-success Alle Wachalarme 
            .card-body
              p Zeigt Ihnen alle Wachalarme der im System hinterlegten Wachen an.
              p.text-info Wollen Sie nur Alarme für einen bestimmten Bereich sehen, wählen Sie bitte einen Alarmmonitor aus den Listen aus.
            .card-footer.text-right
              a.btn.btn-success.ion-md-arrow-round-forward(href='/waip/0' role='button')  alle Wachalarme anzeigen
        .col-12.col-md-5.d-flex.align-self-stretch.p-3
          .card.border-warning.w-100.h-100
            .card-header
              h3.text-warning Alarmmonitor Leitstelle
            .card-body
              p Zeigt alle Wachalarme eines Leitstellebereichs an.
            .card-footer.text-right
              .dropdown
                button.btn.btn-warning.dropdown-toggle(type='button' data-toggle='dropdown' aria-haspopup='true' aria-expanded='false')
                  | bitte ausw&auml;hlen
                .dropdown-menu
                  each item in list_wachen
                    if item.typ == 'leitstelle'
                      a.dropdown-item.d-flex.justify-content-between.align-items-center(href='/waip/'+ item.nr data-nr=item.nr data-name=item.name)
                        span= item.name
                        span.waip-add-chip.ion-md-add-circle.text-success.ml-2(title='Zur Mehrfachauswahl hinzufügen')
        .col-12.col-md-4.d-flex.align-self-stretch.p-3
          .card.w-100.h-100
            .card-header
              h3.text-info Alarmmonitor Wache
            .card-body
              p Zeigt den Wachalarm einer einzelnen Wache (z.B. Feuerwache, Rettungswache etc.) an.
            .card-footer.text-right
              .dropdown
                button.btn.btn-info.dropdown-toggle(type='button' data-toggle='dropdown' aria-haspopup='true' aria-expanded='false')
                  | bitte ausw&auml;hlen
                .dropdown-menu(style='z-index: 2001')
                  each item in list_wachen
                    if item.typ == 'wache'
                      a.dropdown-item.d-flex.justify-content-between.align-items-center(href='/waip/'+ item.nr data-nr=item.nr data-name=item.name)
                        span= item.name
                        span.waip-add-chip.ion-md-add-circle.text-success.ml-2(title='Zur Mehrfachauswahl hinzufügen')
        .col-12.col-md-4.d-flex.align-self-stretch.p-3
          .card.w-100.h-100
            .card-header            
              h3.text-info Alarmmonitor Tr&auml;ger
            .card-body
              p Zeigt alle Wachalarme der Wachen eines Aufgabentr&auml;gers (Amt, amtsfreie Gemeinde, Stadt) an.
            .card-footer.text-right
              .dropdown
                button.btn.btn-info.dropdown-toggle(type='button' data-toggle='dropdown' aria-haspopup='true' aria-expanded='false')
                  | bitte ausw&auml;hlen
                .dropdown-menu(style='z-index: 2001')
                  each item in list_wachen
                    if item.typ == 'traeger'
                      a.dropdown-item.d-flex.justify-content-between.align-items-center(href='/waip/'+ item.nr data-nr=item.nr data-name=item.name)
                        span= item.name
                        span.waip-add-chip.ion-md-add-circle.text-success.ml-2(title='Zur Mehrfachauswahl hinzufügen')
        .col-12.col-md-4.d-flex.align-self-stretch.p-3
          .card.w-100.h-100
            .card-header
              h3.text-info Alarmmonitor Kreis
            .card-body
              p Zeigt alle Wachalarme des gesamten Kreises (in Abhängigkeit der freigeschalteten Wachen) an.
            .card-footer.text-right
              .dropdown
                button.btn.btn-info.dropdown-toggle(type='button' data-toggle='dropdown' aria-haspopup='true' aria-expanded='false')
                  | bitte ausw&auml;hlen
                .dropdown-menu(style='z-index: 2001')
                  each item in list_wachen
                    if item.typ == 'kreis'
                      a.dropdown-item.d-flex.justify-content-between.align-items-center(href='/waip/'+ item.nr data-nr=item.nr data-name=item.name)
                        span= item.name
                        span.waip-add-chip.ion-md-add-circle.text-success.ml-2(title='Zur Mehrfachauswahl hinzufügen')
        .col-12
          div.border-top.mx-3.my-2
      // Mehrfachauswahl-Composer: mehrere Wachen/Träger/Kreise per Klick auf das
      // grüne Plus-Symbol oben sammeln und als eine gemeinsame Alarmmonitor-URL
      // zusammenstellen (Multi-Wache-Alarmmonitor, kommagetrennt, keine Negation).
      .row
        .col-12.p-3
          .card.border-primary.w-100.h-100
            .card-header
              h3.text-primary Mehrfachauswahl (mehrere Wachen gleichzeitig anzeigen)
            .card-body
              p.text-muted Klicken Sie bei den Wachen/Trägern/Kreisen oben auf das grüne Plus-Symbol, um sie hier zu sammeln. Daraus wird eine gemeinsame Alarmmonitor-Adresse erzeugt, die Sie kopieren und z.B. als Lesezeichen speichern können.
              #waipSelectionChips.d-flex.flex-wrap(style='gap:.5rem;')
                span#waipSelectionEmpty.text-muted noch keine Auswahl
            .card-footer.text-right
              button#waipCopyUrl.btn.btn-primary(type='button' disabled) URL kopieren
              span#waipCopyUrlFeedback.text-success.ml-2
        .col-12
          div.border-top.mx-3.my-2
      .row
        .col-12.p-3
          .card.w-100.h-100
            .card-body
              .text-muted Beim Alarmmonitor können Sie optional die Anzeige von Rückmeldungen und Hinweise zur Audioausgabe deaktivieren.
              .text-muted Markieren Sie dazu die jeweilige Option und wählen Sie anschließend den gewünschten Alarmmonitor aus.
            .card-footer.text-center 
              // Checkbox zum Deaktivieren von Rückmeldungen
              .form-check
                input#rmldOff.form-check-input(type='checkbox')
                label.form-check-label(for='rmldOff') Rückmeldungen im Alarmmonitor ausblenden
              // Checkbox zum Deaktivieren der Soundausgabe
              .form-check.mt-2
                input#soundOff.form-check-input(type='checkbox')
                label.form-check-label(for='soundOff') Hinweise zur Audioausgabe deaktivieren (z.B. wenn kein Lautsprecher angeschlossen ist)
    // Client-seitige Suchlogik + rmld=off Handling
    script.
      (function(){
        var data = !{JSON.stringify(list_wachen || [])};
        var input = document.getElementById('searchWache');
        var list = document.getElementById('searchResults');
        var rmldToggle = document.getElementById('rmldOff');
        var soundToggle = document.getElementById('soundOff');
        if(!input || !list) return;
        function sanitize(str){return String(str).replace(/[&<>"']/g,function(c){return({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;','\'':'&#39;'}[c]);});}
        function buildUrl(base){
          var params = [];
          if(rmldToggle && rmldToggle.checked){ params.push('rmld=off'); }
          if(soundToggle && soundToggle.checked){ params.push('sound=off'); }
          if(!params.length) return base;
          return base + (base.indexOf('?')===-1?'?':'&') + params.join('&');
        }
        function render(results){
          list.innerHTML='';
          if(!results.length){ list.style.display='none'; return; }
            results.forEach(function(item){
              var li = document.createElement('li');
              li.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center';
              li.setAttribute('role','option');
              li.innerHTML =
                '<span><strong>'+ sanitize(item.name) + '</strong> <small class="text-muted">(' + sanitize(item.nr) + ', ' + sanitize(item.typ) + ')</small></span>' +
                '<span class="waip-add-chip ion-md-add-circle text-success ml-2" data-nr="' + sanitize(item.nr) + '" data-name="' + sanitize(item.name) + '" title="Zur Mehrfachauswahl hinzufügen"></span>';
              li.addEventListener('click', function(ev){
                if(ev.target.closest('.waip-add-chip')) return;
                window.location.href = buildUrl('/waip/' + item.nr);
              });
              list.appendChild(li);
            });
          list.style.display='block';
        }
        input.addEventListener('keyup', function(){
          var q = input.value.trim().toLowerCase();
          if(!q){ list.style.display='none'; list.innerHTML=''; return; }
          var filtered = data.filter(function(item){
            var name = (item.name||'').toLowerCase();
            var nr = String(item.nr||'').toLowerCase();
            return name.indexOf(q) > -1 || nr.indexOf(q) > -1;
          }).slice(0,50);
          render(filtered);
        });
        document.addEventListener('click', function(e){
          if(!list.contains(e.target) && e.target !== input){ list.style.display='none'; }
        });
        // Links der Karten / Dropdowns dynamisch anreichern
        document.querySelectorAll('a[href^="/waip/"]').forEach(function(a){
          a.addEventListener('click', function(ev){
            if((rmldToggle && rmldToggle.checked) || (soundToggle && soundToggle.checked)){
              ev.preventDefault();
              var url = buildUrl(a.getAttribute('href'));
              window.location.href = url;
            }
          });
        });

        // Mehrfachauswahl-Composer: gesammelte Wachen zu einer gemeinsamen
        // Alarmmonitor-URL zusammenstellen (kommagetrennt, keine Negation)
        var selection = []; // [{nr, name}, ...]
        var chipsEl = document.getElementById('waipSelectionChips');
        var emptyEl = document.getElementById('waipSelectionEmpty');
        var copyBtn = document.getElementById('waipCopyUrl');
        var copyFeedback = document.getElementById('waipCopyUrlFeedback');

        function renderChips(){
          if(!chipsEl) return;
          chipsEl.querySelectorAll('.waip-chip').forEach(function(el){ el.remove(); });
          emptyEl.style.display = selection.length ? 'none' : '';
          copyBtn.disabled = selection.length === 0;
          copyFeedback.textContent = '';
          selection.forEach(function(item){
            var chip = document.createElement('span');
            chip.className = 'waip-chip badge badge-primary p-2';
            chip.innerHTML = sanitize(item.name) + ' <span class="ion-md-close-circle ml-1" style="cursor:pointer" title="Entfernen"></span>';
            chip.querySelector('.ion-md-close-circle').addEventListener('click', function(){
              selection = selection.filter(function(s){ return s.nr !== item.nr; });
              renderChips();
            });
            chipsEl.appendChild(chip);
          });
        }

        function addToSelection(nr, name){
          if(!nr || selection.some(function(s){ return s.nr === nr; })) return;
          selection.push({ nr: nr, name: name });
          renderChips();
        }

        // Delegierter Klick-Handler, da Suchergebnisse dynamisch erzeugt werden
        document.addEventListener('click', function(e){
          var addIcon = e.target.closest ? e.target.closest('.waip-add-chip') : null;
          if(!addIcon) return;
          e.preventDefault();
          e.stopPropagation();
          addToSelection(addIcon.getAttribute('data-nr'), addIcon.getAttribute('data-name'));
        });

        if(copyBtn){
          copyBtn.addEventListener('click', function(){
            var nrList = selection.map(function(s){ return s.nr; }).join(',');
            var url = buildUrl(window.location.origin + '/waip/' + nrList);
            var done = function(){ copyFeedback.textContent = 'kopiert!'; };
            if(navigator.clipboard && navigator.clipboard.writeText){
              navigator.clipboard.writeText(url).then(done).catch(function(){
                window.prompt('URL kopieren:', url);
              });
            } else {
              window.prompt('URL kopieren:', url);
            }
          });
        }
      })();
