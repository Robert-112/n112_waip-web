extends ../layout

append head
  link(rel='stylesheet', href='/css/dataTables.bootstrap5.min.css')
  link(rel='stylesheet', href='/css/leaflet.css')
  script(src='/js/leaflet.js')
  script(src='/js/admin_karte.js')
  script(src='/js/datatables.min.js')
  script(src='/js/dataTables.bootstrap5.min.js')

block content
  main(role='main')
    .container-fluid
      +seitenkopf('Wachen', 'Stammdaten der Wachen: Zuordnung zu Leitstelle, Kreis und Träger sowie Koordinaten.', 'bi-building')
      +meldungen(error, success)

      .d-flex.flex-wrap.align-items-center.justify-content-between.gap-2.mb-3
        p.text-body-secondary.mb-0 #{wachen.length} Wachen, davon #{wachen.filter((w) => w.aktiv != 1).length} inaktiv. Bearbeiten über den Stift am Zeilenende.
        button.btn.btn-success.btn-sm(type='button', data-wache-neu)
          i.bi.bi-plus-lg.me-1(aria-hidden='true')
          | Wache anlegen

      .card.border-0
        .card-body
          table#wachen_tabelle.table.table-hover.table-sm.align-middle.w-100
            thead
              tr
                th(scope='col', style='width: 90px') Nr.
                th(scope='col') Wache
                th(scope='col') Träger
                th(scope='col') Kreis
                th(scope='col') Leitstelle
                th(scope='col', style='width: 80px') Aktiv
                th.text-end(scope='col', style='width: 60px')
                  span.visually-hidden Aktion
            tbody
              each w in wachen
                tr(class=w.aktiv != 1 ? 'text-body-secondary' : null)
                  td.font-monospace.text-body-secondary= w.nr_wache
                  td
                    span= w.name_wache
                    if w.name_beschreibung
                      span.small.text-body-secondary.ms-2= w.name_beschreibung
                  td= w.name_traeger
                  td= w.name_kreis
                  td= w.name_leitstelle
                  td
                    if w.aktiv == 1
                      i.bi.bi-check-circle.text-success.me-1(aria-hidden='true')
                      | ja
                    else
                      i.bi.bi-x-circle.text-body-secondary.me-1(aria-hidden='true')
                      | nein
                  td.text-end
                    button.btn.btn-sm.btn-link.text-body(type='button', data-wache-id=w.id, title='Wache ' + w.nr_wache + ' bearbeiten', aria-label='Wache ' + w.nr_wache + ' bearbeiten')
                      i.bi.bi-pencil(aria-hidden='true')

  //- Bearbeiten und Anlegen im Dialog (wie die Benutzerverwaltung)
  #wacheModal.modal.fade(tabindex='-1', aria-labelledby='wacheTitel', aria-hidden='true')
    .modal-dialog.modal-dialog-centered.modal-lg.modal-dialog-scrollable
      .modal-content
        .modal-header
          h2#wacheTitel.modal-title.h5 Wache bearbeiten
          button.btn-close(type='button', data-bs-dismiss='modal', aria-label='Schließen')
        .modal-body
          form#wacheForm(action='/adm_edit_wachen/edit', method='post')
            input(type='hidden', name='_csrf', value=csrf_token)
            input#w_id(type='hidden', name='id')

            h3.h6.text-body-secondary.mb-2 Wache
            .row.g-2.mb-3
              .col-4.col-md-3
                label.form-label(for='w_nr_wache') Nummer
                input#w_nr_wache.form-control(type='text', name='nr_wache', required, pattern='\\d{6}', maxlength='6', inputmode='numeric', title='Genau 6 Ziffern')
              .col-8.col-md-5
                label.form-label(for='w_name_wache') Name
                input#w_name_wache.form-control(type='text', name='name_wache', required)
              .col-12.col-md-4.d-flex.align-items-end
                .form-check.form-switch.mb-2
                  input#w_aktiv.form-check-input(type='checkbox', role='switch', name='aktiv')
                  label.form-check-label(for='w_aktiv') aktiv
              .col-md-6
                label.form-label(for='w_name_beschreibung') Beschreibung
                input#w_name_beschreibung.form-control(type='text', name='name_beschreibung')
              .col-md-6
                label.form-label(for='w_name_erweiterung') Erweiterung
                input#w_name_erweiterung.form-control(type='text', name='name_erweiterung')

            h3.h6.text-body-secondary.mb-2 Zuordnung
            .row.g-2.mb-3
              .col-3.col-md-2
                label.form-label(for='w_nr_leitstelle') Nr. Leitst.
                input#w_nr_leitstelle.form-control(type='text', name='nr_leitstelle', required, pattern='[0-9]', maxlength='1', inputmode='numeric', title='Eine Ziffer')
              .col-6.col-md-7
                label.form-label(for='w_name_leitstelle') Leitstelle
                input#w_name_leitstelle.form-control(type='text', name='name_leitstelle', required)
              .col-3.col-md-3
                label.form-label(for='w_kfz_leitstelle') KFZ
                input#w_kfz_leitstelle.form-control(type='text', name='kfz_leitstelle')
              .col-3.col-md-2
                label.form-label(for='w_nr_kreis') Nr. Kreis
                input#w_nr_kreis.form-control(type='text', name='nr_kreis', pattern='\\d{2}', maxlength='2', inputmode='numeric', title='2 Ziffern oder leer')
              .col-6.col-md-7
                label.form-label(for='w_name_kreis') Kreis
                input#w_name_kreis.form-control(type='text', name='name_kreis')
              .col-3.col-md-3
                label.form-label(for='w_kfz_kreis') KFZ
                input#w_kfz_kreis.form-control(type='text', name='kfz_kreis')
              .col-3.col-md-2
                label.form-label(for='w_nr_traeger') Nr. Träger
                input#w_nr_traeger.form-control(type='text', name='nr_traeger')
              .col-9.col-md-6
                label.form-label(for='w_name_traeger') Träger
                input#w_name_traeger.form-control(type='text', name='name_traeger')
              .col-6.col-md-2
                label.form-label(for='w_nr_standort') Standort
                input#w_nr_standort.form-control(type='text', name='nr_standort')
              .col-6.col-md-2
                label.form-label(for='w_nr_abteilung') Abteilung
                input#w_nr_abteilung.form-control(type='text', name='nr_abteilung')

            h3.h6.text-body-secondary.mb-2 Koordinate
            .row.g-2
              .col-6.col-md-4
                label.form-label(for='w_wgs84_x') Breite (Lat)
                input#w_wgs84_x.form-control(type='text', name='wgs84_x', inputmode='decimal', pattern='-?\\d{1,3}\\.\\d+', title='Dezimalformat, z.B. 52.12345')
              .col-6.col-md-4
                label.form-label(for='w_wgs84_y') Länge (Lon)
                input#w_wgs84_y.form-control(type='text', name='wgs84_y', inputmode='decimal', pattern='-?\\d{1,3}\\.\\d+', title='Dezimalformat, z.B. 13.12345')
              .col-12.col-md-4.d-flex.align-items-end
                .form-text.mb-2 Punkt ziehen oder in die Karte klicken.
              .col-12
                #w_karte.rounded.border(style='height: 260px')
          form#wacheLoeschen(action='/adm_edit_wachen/delete', method='post')
            input(type='hidden', name='_csrf', value=csrf_token)
            input#w_loeschen_id(type='hidden', name='id')
        .modal-footer
          button#w_loeschen.btn.btn-outline-danger.me-auto(type='submit', form='wacheLoeschen')
            i.bi.bi-trash.me-1(aria-hidden='true')
            | Löschen
          button.btn.btn-secondary(type='button', data-bs-dismiss='modal') Abbrechen
          button.btn.btn-primary(type='submit', form='wacheForm') Speichern

  script#wachen_daten(type='application/json')!= JSON.stringify(wachen).replace(/</g, '\\u003c')
  script.
    (function () {
      const wachen = new Map(JSON.parse(document.getElementById("wachen_daten").textContent).map((w) => [String(w.id), w]));
      const FELDER = ["nr_wache", "name_wache", "name_beschreibung", "name_erweiterung", "nr_leitstelle", "name_leitstelle", "kfz_leitstelle", "nr_kreis", "name_kreis", "kfz_kreis", "nr_traeger", "name_traeger", "nr_standort", "nr_abteilung", "wgs84_x", "wgs84_y"];
      const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById("wacheModal"));
      const karte = admin_karte(document.getElementById("w_karte"), !{JSON.stringify(map_service)}, { lat: document.getElementById("w_wgs84_x"), lon: document.getElementById("w_wgs84_y") });
      document.getElementById("wacheModal").addEventListener("shown.bs.modal", () => karte.zeigen());
      const form = document.getElementById("wacheForm");

      function oeffnen(w) {
        form.reset();
        form.action = w ? "/adm_edit_wachen/edit" : "/adm_edit_wachen/create";
        document.getElementById("wacheTitel").textContent = w ? "Wache " + w.nr_wache + " bearbeiten" : "Wache anlegen";
        document.getElementById("w_id").value = w ? w.id : "";
        document.getElementById("w_loeschen_id").value = w ? w.id : "";
        document.getElementById("w_loeschen").classList.toggle("d-none", !w);
        FELDER.forEach((f) => (document.getElementById("w_" + f).value = w && w[f] != null ? w[f] : ""));
        document.getElementById("w_aktiv").checked = w ? w.aktiv == 1 : true;
        modal.show();
      }

      document.getElementById("w_loeschen").addEventListener("click", function (ev) {
        if (!confirm("Wache " + document.getElementById("w_nr_wache").value + " wirklich löschen?")) ev.preventDefault();
      });
      document.querySelector("[data-wache-neu]").addEventListener("click", () => oeffnen(null));
      // Klicks über die Tabelle (DataTables baut die Zeilen beim Blättern neu auf)
      document.getElementById("wachen_tabelle").addEventListener("click", function (ev) {
        const btn = ev.target.closest("[data-wache-id]");
        if (btn) oeffnen(wachen.get(btn.dataset.wacheId));
      });

      $("#wachen_tabelle").DataTable({
        language: { url: "/js/datatables_german.json" },
        pageLength: 25,
        lengthMenu: [25, 50, 100, 500],
        order: [[0, "asc"]],
        columnDefs: [{ targets: -1, orderable: false, searchable: false }],
      });
    })();
