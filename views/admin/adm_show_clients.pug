extends ../layout

append head
  link(rel='stylesheet', href='/css/dataTables.bootstrap5.min.css')
  script(src='/js/datatables.min.js')
  script(src='/js/dataTables.bootstrap5.min.js')

  // TODO: Seite mit aktiven Clients anpassen:
  //  - nicht zwingend als Tabelle, sondern eher als .col mit Buttons um Aktionen an Clients zu senden
  //  - einzelnen Client über Verwaltungsoberfläche neu laden lassen

block content
  main(role='main')
    .container-fluid
      +seitenkopf('Verbundene PCs und Benutzer', 'Alle jetzt verbundenen Clients und deren Status.', 'bi-globe')
      .row
        .col-12
          .table-responsive
            table#table_active_user.table.table-striped.table-bordered.table-hover.table-sm.w-100
              thead
                tr
                  th ID
                  th Verbunden seit
                  th Socket-ID
                  th Benutzername
                  th Berechtigungen
                  th Client-IPs
                  th Namespace
                  th Raum 
                  th Client-Status (Einsatz-ID)
                  th Reset-Zeitstempel
                  th Netzkopplung
                  th Netzkopplung geprüft am
        .col-12.mt-2
          small Netzkopplung: „Ja“ = alle Internet-Testadressen erreichbar, „Teilweise“ = nur einzelne erreichbar (ebenfalls Verdacht), „Nein“ = keine erreichbar, „unbekannt“ = noch nicht geprüft.

  script.
    let datasets = !{JSON.stringify(dataSet).replace(/<\//g, '<\\/')}
    $(document).ready(function() {
      $('#table_active_user').DataTable( {
        "data": datasets,
        "language":
          { "url": "/js/datatables_german.json" },
        // alle Werte als Text ausgeben (DataTables fügt Inhalte sonst als HTML ein).
        // Eigene "render"-Funktionen unter "columns" haben Vorrang (Netzkopplung escapet selbst).
        "columnDefs": [{ "targets": "_all", "render": $.fn.dataTable.render.text() }],
        "columns": [
          { "data": "id" },
          { "data": "connect_time" },
          { "data": "socket_id" },
          { "data": "user_name"},
          { "data": "user_permissions" },
          { "data": "client_ips" },
          { "data": "client_nsp" },
          { "data": "client_room" },
          { "data": "client_status" },
          { "data": "reset_timestamp" },
          { "data": "netzkopplung", "render": function(data, type, row) {
              // erreichbare Testadressen anhaengen (escapen, da DataTables den Inhalt als HTML einfuegt)
              const hosts = row.netzkopplung_erreichbar ? " (" + $("<div>").text(row.netzkopplung_erreichbar).html() + ")" : "";
              if (data === 1) return "Ja" + hosts;
              if (data === 2) return "Teilweise" + hosts;
              if (data === 0) return "Nein";
              return "unbekannt";
            }
          },
          { "data": "netzkopplung_checked_at", "defaultContent": "-" }
        ]
      });
    });
