extends ../layout

block content
  //- Name eines Keycloak anhand seiner ID (OIDC_PROVIDER) für die Anzeige
  - const anmeldung_name = (id) => { const a = (anmeldungen || []).find((x) => x.id === id); return a ? a.name : id; }
  main(role='main')
    .container
      +seitenkopf('Benutzer und Rechte', 'Benutzer anlegen, bearbeiten und löschen.', 'bi-people-fill')
      +meldungen(error, success)
      .row.mt-2
        .col-12.mb-3
          button.btn.btn-success.bi-plus-circle-fill(onclick='addUser();')  Benutzer hinzufügen
        .col-12
          table.table.table-striped.table-hover.table-sm
            thead.table-dark
              tr
                th Benutzername
                th Beschreibung
                th Anmeldung
                th Wachen-Rechte
                th Lokale Rollen
                th.text-end Aktionen
            tbody
              each val in users
                tr
                  td= val.user
                  td.text-muted= val.description || ''
                  td
                    if val.oidc_provider
                      span.badge.text-bg-info
                        i.bi.bi-key.me-1(aria-hidden='true')
                        | #{anmeldung_name(val.oidc_provider)}
                    else
                      span.text-body-secondary Wachalarm
                  td
                    if val.permissions == 'admin'
                      span.text-body-secondary alle
                    else
                      | #{val.permissions}
                    if val.oidc_provider && val.permissions != 'admin'
                      .small.text-body-secondary
                        | Keycloak: #{val.permissions_extern || '–'} · lokal: #{val.permissions_lokal || '–'}
                        if val.rechte_modus == 'ersetzen'
                          |  (ersetzt Keycloak)
                  td
                    if val.permissions_lokal == 'admin'
                      span.badge.text-bg-danger.me-1
                        i.bi.bi-shield-lock-fill.me-1(aria-hidden='true')
                        | Administrator
                    if String(val.rollen || '').split(',').includes('datenpflege')
                      span.badge.text-bg-warning
                        i.bi.bi-exclamation-triangle-fill.me-1(aria-hidden='true')
                        | Datenpfleger
                  td.text-end.text-nowrap
                    button.btn.btn-sm.btn-primary.mx-1.bi-pencil-square(onclick='EditUser(this);', data-id=val.id, data-user=val.user, data-permissions_lokal=val.permissions_lokal, data-permissions_extern=val.permissions_extern, data-rechte_modus=val.rechte_modus, data-extern_aktualisiert=val.extern_aktualisiert || '', data-oidc_provider=val.oidc_provider || '', data-oidc_sub=val.oidc_sub || '', data-rollen=val.rollen || '', data-ip_address=val.ip_address, data-description=val.description)  Bearbeiten
                    button.btn.btn-sm.btn-secondary.mx-1.bi-gear(type='button', onclick='EinstellungenUser(this);', data-id=val.id, data-user=val.user)  Einstellungen
                    form(action='/adm_edit_users', method='POST', style='display:inline-block;')
                      input(type="hidden" name="_csrf" value=csrf_token)
                      input(type='hidden', name='modal_method', value='DELETE')
                      input(type='hidden', name='id', value=val.id)
                      input(type='hidden', name='username', value=val.user)
                      button.btn.btn-sm.btn-danger.mx-1.bi-trash(type='submit', value='submit')  Löschen

  #userModal.modal.fade(tabindex='-1', role='dialog', aria-hidden='true')
    .modal-dialog.modal-dialog-centered(role='document')
      .modal-content
        .modal-header
          h5#userModalTitle.modal-title Edit User
          button.btn-close(type='button', data-bs-dismiss='modal', aria-label='Schließen')
        .modal-body
          form#formModal(action="/adm_edit_users", method="POST", oninput='password2.setCustomValidity(password2.value != password.value ? "Passwörter stimmen nicht überein!" : "")')
            input(type="hidden" name="_csrf" value=csrf_token)
            .mb-3
              input#modal_method(type='hidden', name='modal_method', value='')
              input#modal_id(type='hidden', name='modal_id', value='')
              label.form-label(for='username') Benutzername
              input#username.form-control(type='text', name='username', placeholder='Benutzername ...', readonly='')
              .form-text.text-muted Der Benutzername sollte eindeutig und nachvollziehbar sein.
            //- Anmeldung über Keycloak nur anbieten, wenn mindestens ein Keycloak eingerichtet ist
            if anmeldungen && anmeldungen.length > 0
              .mb-3
                label.form-label(for='anmeldung') Anmeldung über
                select#anmeldung.form-select(name='anmeldung')
                  option(value='') Wachalarm (Passwort oder Zertifikat)
                  each a in anmeldungen
                    option(value=a.id)= a.name
                #oidc_feld.mt-2.d-none
                  label.form-label(for='oidc_sub') Keycloak-ID des Benutzers
                  input#oidc_sub.form-control.font-monospace(type='text', name='oidc_sub', placeholder='z.B. 3f2c9a1e-7b4d-4c1a-9e2f-0a1b2c3d4e5f', pattern='[\\w.@:\\|+\\-]{1,255}')
                  .form-text In Keycloak unter „Benutzer“ → Benutzer öffnen → Feld „ID“. Damit wird dieses Konto mit dem Keycloak-Konto verknüpft, die Anmeldung per Passwort entfällt.
            fieldset.mb-3
              legend.form-label.fs-6.mb-2 Lokale Rollen
              .form-check
                input#rolle_admin.form-check-input(type='checkbox', name='rolle_admin', value='1')
                label.form-check-label(for='rolle_admin') Administrator
                .form-text.text-muted Darf alle Einstellungen bearbeiten und sieht alle Wachalarme.
              .border.border-warning.rounded.bg-warning.bg-opacity-10.p-2.mt-2
                .form-check
                  input#rolle_datenpflege.form-check-input(type='checkbox', name='rollen', value='datenpflege')
                  label.form-check-label.fw-bold.text-warning(for='rolle_datenpflege')
                    i.bi.bi-exclamation-triangle-fill.me-1(aria-hidden='true')
                    | Datenpfleger
                  .form-text Darf Wachen, Wetter-Standorte, Ticker-Quellen sowie Ersetzungen und Aussprache für alle Leitstellen bearbeiten – das wirkt auf alle Alarmmonitore. Keine Benutzerverwaltung, Einsätze und Log.
              .form-text.text-muted Lokale Rollen werden nur hier im Wachalarm vergeben, nie über Keycloak.
            //- Wachen-Rechte entfallen für Administratoren (sehen ohnehin alle Wachalarme)
            fieldset#rechte_feld.mb-3
              legend.form-label.fs-6.mb-2 Wachen-Rechte
              #rechte_extern_feld.d-none.mb-2
                .small.text-body-secondary Aus Keycloak (bei jeder Anmeldung aktualisiert):
                .font-monospace#rechte_extern –
                .small.text-body-secondary#rechte_extern_zeit
              label.form-label.small(for='waip_rights')#waip_rights_label Wachen-, Kreis- oder Leitstellennummern
              input#waip_rights.form-control(type='text', name='waip_rights', pattern='api|keine|[0-9]+( *, *[0-9]+)*', placeholder='00,0000,00000,000001,...')
              #rechte_modus_feld.d-none.mt-2
                .form-check
                  input#modus_ergaenzen.form-check-input(type='radio', name='rechte_modus', value='ergaenzen', checked='')
                  label.form-check-label(for='modus_ergaenzen') zu den Rechten aus Keycloak hinzufügen (Standard)
                .form-check
                  input#modus_ersetzen.form-check-input(type='radio', name='rechte_modus', value='ersetzen')
                  label.form-check-label(for='modus_ersetzen') statt der Rechte aus Keycloak verwenden
            .mb-3
              label.form-label(for='description') Beschreibung
              input#description.form-control(type='text', name='description', placeholder='Optionale Beschreibung ...')
              .form-text.text-muted Kurze Beschreibung des Benutzers (optional).
            #passwort_feld.mb-3
              label.form-label(for='UserPassword') Passwort
              input#UserPassword.form-control(type='password', name='password', placeholder='...')
              label.form-label(for='UserPassword2') Passwort erneut eingeben
              input#UserPassword2.form-control(type='password', name='password2', placeholder='...')
            //.mb-3
              label.form-label IP-Adresse
              input#ip.form-control(type='text', name='ip', placeholder='0.0.0.0 ...', pattern='^([0-9]{1,3}\.){3}[0-9]{1,3}$')
              .form-text.text-muted Die IP-Adresse dient zur automatischen Authentifizierung von Benuztern und ist optional
        .modal-footer
          button.btn.btn-primary(type='submit', form="formModal", value='submit') Speichern
          button#userModalClose.btn.btn-secondary(type='button', data-bs-dismiss='modal') Abbrechen

  //- persönliche Einstellungen eines Benutzers (wie unter „Einstellungen“ des Benutzers selbst)
  #einstellungenModal.modal.fade(tabindex='-1', aria-labelledby='einstellungenTitel', aria-hidden='true')
    .modal-dialog.modal-dialog-centered.modal-lg.modal-dialog-scrollable
      .modal-content
        .modal-header
          h5#einstellungenTitel.modal-title Einstellungen
          button.btn-close(type='button', data-bs-dismiss='modal', aria-label='Schließen')
        .modal-body
          form#einstellungenForm(action='/adm_edit_users/einstellungen', method='POST')
            input(type='hidden', name='_csrf', value=csrf_token)
            input#einst_user_id(type='hidden', name='user_id', value='')
            p.small.text-body-secondary Persönliche Einstellungen des Benutzers. Änderungen gelten sofort für alle seine Alarmmonitore (Anzeigezeit und Kartenbreite nach dem Neuladen).
            .row.g-3.mb-3
              .col-12.col-md-6
                label.form-label(for='einst_reset') Anzeigezeit für Wachalarme (Minuten)
                select#einst_reset.form-select(name='set_reset_counter')
                  option(value='') Standard (#{anzeigezeit_standard} Min.)
                  each _, i in Array(anzeigezeit_max)
                    option(value=i+1)= i+1
              .col-12.col-md-6
                label.form-label(for='einst_karte') Kartenbreite im Alarmmonitor
                select#einst_karte.form-select(name='karte_breite')
                  option(value='') Standard
                  each b in [20, 25, 30, 35, 40, 45, 50, 55, 60]
                    option(value=b)= b + ' %'
            h6.mt-2 Standby-Anzeige
            .d-flex.flex-column.gap-3
              .form-check.form-switch
                input#einst_wetter.form-check-input(type='checkbox', role='switch', name='standby_wetter', disabled=!widgets_wetter_aktiv)
                label.form-check-label(for='einst_wetter') Wetter und amtliche Unwetterwarnungen
              div
                .form-check.form-switch
                  input#einst_kalender.form-check-input(type='checkbox', role='switch', name='standby_kalender', disabled=!widgets_kalender_aktiv)
                  label.form-check-label(for='einst_kalender') Termine aus einem Kalender
                label.form-label.mt-2(for='einst_ical') Öffentliche Kalender-Adresse (iCal/ICS)
                input#einst_ical.form-control(type='url', name='ical_url', maxlength='2000', placeholder='https://…', disabled=!widgets_kalender_aktiv)
                +kalender_status('ical_url')
              div
                label.form-label(for='einst_ticker') Kalender-Adresse für Ticker-Meldungen (iCal/ICS, optional)
                input#einst_ticker.form-control(type='url', name='ticker_url', maxlength='2000', placeholder='https://…', disabled=!widgets_kalender_aktiv)
                +kalender_status('ticker_url')
              +kalender_hinweis(widgets_kalender_aktiv, widgets_kalender_erlaubt)
        .modal-footer
          button.btn.btn-primary(type='submit', form='einstellungenForm') Speichern
          button.btn.btn-secondary(type='button', data-bs-dismiss='modal') Abbrechen

  script(src='/js/kalender_status.js')
  script#einstellungen_daten(type='application/json')!= JSON.stringify(einstellungen || {}).replace(/</g, '\\u003c')
  script.
    const einstellungen_alle = JSON.parse(document.getElementById("einstellungen_daten").textContent);
    let EinstellungenUser = function(knopf) {
      const id = knopf.getAttribute("data-id");
      const e = einstellungen_alle[id] || { standby: {} };
      const form = document.getElementById("einstellungenForm");
      form.reset();
      document.getElementById("einstellungenTitel").textContent = "Einstellungen von " + knopf.getAttribute("data-user");
      document.getElementById("einst_user_id").value = id;
      document.getElementById("einst_reset").value = e.resetcounter ? String(e.resetcounter) : "";
      document.getElementById("einst_karte").value = e.karte_breite == null ? "" : String(e.karte_breite);
      document.getElementById("einst_wetter").checked = Boolean(e.standby.wetter);
      document.getElementById("einst_kalender").checked = Boolean(e.standby.kalender);
      document.getElementById("einst_ical").value = e.standby.ical_url || "";
      document.getElementById("einst_ticker").value = e.standby.ticker_url || "";
      bootstrap.Modal.getOrCreateInstance(document.getElementById("einstellungenModal")).show();
      if (#{widgets_kalender_aktiv ? 'true' : 'false'} && (e.standby.ical_url || e.standby.ticker_url)) {
        kalender_status_laden(form, "/adm_edit_users/kalender_status", { _csrf: form.elements._csrf.value, user_id: Number(id) });
      } else {
        form.querySelectorAll("[data-kalender-status]").forEach((z) => z.classList.add("d-none"));
      }
    }

  script.
    $('#formModal').trigger("reset");
    // neues Konto braucht ein Passwort, beim Bearbeiten bleibt es ohne Eingabe unverändert
    let neues_konto = false;
    let addUser = function() {
      $('#formModal').trigger("reset");
      neues_konto = true;
      $("#userModalTitle").text("neuen Benutzer hinzufügen");
      $("#modal_method").val("ADDNEW");
      $("#modal_id").val("");
      $("#username").prop("readonly", false);
      $("#username").prop("required", true);
      $("#rechte_extern").text("–");
      $("#rechte_extern_zeit").text("");
      felder_umschalten();
      $('#userModal').modal('show');
    }
    let EditUser = function(current_user) {
      // attr statt data, damit Nummern wie "52" Text bleiben
      const wert = (name) => $(current_user).attr("data-" + name) || "";
      $('#formModal').trigger("reset");
      neues_konto = false;
      $("#userModalTitle").text("Benutzer bearbeiten");
      $("#modal_method").val("EDIT");
      $("#modal_id").val(wert("id"));
      $("#username").prop("readonly", true).val(wert("user"));
      const lokal = wert("permissions_lokal");
      $("#rolle_admin").prop("checked", lokal == "admin");
      $("#waip_rights").val(lokal == "admin" ? "" : lokal);
      $("#rolle_datenpflege").prop("checked", wert("rollen").split(",").includes("datenpflege"));
      $("#anmeldung").val(wert("oidc_provider"));
      $("#oidc_sub").val(wert("oidc_sub"));
      $(wert("rechte_modus") == "ersetzen" ? "#modus_ersetzen" : "#modus_ergaenzen").prop("checked", true);
      $("#rechte_extern").text(wert("permissions_extern") || "–");
      $("#rechte_extern_zeit").text(wert("extern_aktualisiert") ? "zuletzt: " + wert("extern_aktualisiert") : "noch keine Anmeldung über Keycloak");
      $("#ip").val(wert("ip_address"));
      $("#description").val(wert("description"));
      felder_umschalten();
      $('#userModal').modal('show');
    }
    // Felder je nach Anmeldung (Wachalarm/Keycloak) und Rolle Administrator ein- und ausblenden
    let felder_umschalten = function() {
      const keycloak = ($("#anmeldung").val() || "") !== "";
      const admin = $("#rolle_admin").is(":checked");
      $("#oidc_feld").toggleClass("d-none", !keycloak);
      $("#oidc_sub").prop("required", keycloak);
      $("#passwort_feld").toggleClass("d-none", keycloak);
      $("#UserPassword").prop("required", neues_konto && !keycloak);
      $("#rechte_feld").toggleClass("d-none", admin);
      $("#rechte_extern_feld, #rechte_modus_feld").toggleClass("d-none", !keycloak);
      $("#waip_rights_label").text(keycloak ? "Lokale Wachen-Rechte (optional)" : "Wachen-, Kreis- oder Leitstellennummern");
      // ohne Keycloak sind Wachen-Rechte Pflicht, Administratoren brauchen keine
      $("#waip_rights").prop("required", !admin && !keycloak);
      // Administratoren dürfen ohnehin alles
      $("#rolle_datenpflege").prop("disabled", admin);
      if (admin) $("#rolle_datenpflege").prop("checked", false);
    }
    $("#anmeldung, #rolle_admin").on("change", felder_umschalten);
