extends ../layout

append head
  link(rel='stylesheet', href='/css/leaflet.css')
  script(src='/js/leaflet.js')
  script(src='/js/admin_karte.js')

block content
  main(role='main')
    .container-fluid
      +seitenkopf('Wetter-Standorte', 'Koordinaten und Warnzellen für Wetter und Unwetterwarnungen im Standby des Alarmmonitors.', 'bi-cloud-sun')
      +meldungen(error, success)

      .row.g-3.mb-4
        .col-12.col-lg-8
          .card.border-0.h-100
            .card-body
              h2.h6.card-title.d-flex.align-items-center.gap-2
                i.bi.bi-diagram-3(aria-hidden='true')
                span So wird der Standort eines Monitors bestimmt
              p.card-text.text-body-secondary.mb-2
                | Es gilt zuerst ein eigener Eintrag genau für die aufgerufene Nummer (Wache 6-stellig, Träger 4, Kreis 2, Leitstelle 1).
                | Ohne eigenen Eintrag gilt der „Mittelpunkt der Wachen“: die Koordinate der Wache bzw. bei Träger, Kreis und Leitstelle der Mittelpunkt aller ihrer Wachen (grau in der Tabelle).
                | Erst wenn es auch dafür keine Koordinate gibt, gilt der nächste übergeordnete Eintrag (Träger → Kreis → Leitstelle).
              p.card-text.text-body-secondary.mb-0
                | Warnzelle „aus Koordinate“ = Bright Sky ermittelt das Warngebiet (Gemeinde) aus der Koordinate. Für Kreis- oder Leitstellen-Monitore lohnt sich eine feste Warnzelle.
                | Massenimport per SQL in die Tabelle
                code.ms-1 waip_wetter_orte
                |  (nr, name, lat, lon, warncell_id).
        .col-12.col-lg-4
          .card.border-0.h-100
            .card-body
              h2.h6.card-title.d-flex.align-items-center.gap-2
                i.bi.bi-hdd-network(aria-hidden='true')
                span Dienste
              .d-flex.flex-column.gap-1.text-body-secondary
                .d-flex.justify-content-between.gap-2
                  span Bright Sky
                  if wetter_aktiv
                    code.text-break= brightsky_url
                  else
                    span.badge.text-bg-secondary.align-self-center nicht eingerichtet
                .d-flex.justify-content-between.gap-2
                  span Status
                  span#wetter_status.badge.text-bg-secondary.align-self-center unbekannt
                .d-flex.justify-content-between.gap-2.mt-2
                  span Waldbrand
                  if waldbrand_url
                    code.text-break= waldbrand_url
                  else
                    span.badge.text-bg-secondary.align-self-center nicht eingerichtet
                .d-flex.justify-content-between.gap-2
                  span Status
                  span#waldbrand_status.badge.text-bg-secondary.align-self-center unbekannt
                if waldbrand_url
                  .d-flex.justify-content-between.gap-2
                    span Anzeige
                    span ab Stufe #{waldbrand_ab_stufe}
              p.small.text-body-secondary.mt-2.mb-0
                | Adressen und Intervalle werden in der
                code.mx-1 .env
                | eingestellt (WIDGET_BRIGHTSKY_URL, WIDGET_WALDBRAND_URL usw.).

      .d-flex.flex-wrap.align-items-center.justify-content-between.gap-2.mb-3
        form.d-flex.gap-2#test_nr_form
          label.visually-hidden(for='test_nr') Nummer testen
          input#test_nr.form-control.form-control-sm(type='text', inputmode='numeric', placeholder='Nummer testen, z. B. 510001', style='width: 220px')
          button.btn.btn-sm.btn-outline-secondary.text-nowrap(type='submit')
            i.bi.bi-eye.me-1(aria-hidden='true')
            | Testen
        button.btn.btn-success.btn-sm(type='button', data-ort-neu)
          i.bi.bi-plus-lg.me-1(aria-hidden='true')
          | Standort für Träger oder Wache

      if zeilen.length === 0
        p.text-body-secondary Es sind keine aktiven Wachen mit Leitstelle oder Kreis angelegt.
      else
        .card.border-0
          .table-responsive
            table.table.table-hover.align-middle.mb-0
              thead
                tr
                  th(scope='col') Standort
                  th.text-end(scope='col', style='width: 90px') Nr.
                  th(scope='col') Koordinate
                  th(scope='col') Warnzelle
                  th(scope='col') Herkunft
                  th.text-end(scope='col', style='width: 110px')
                    span.visually-hidden Aktion
              tbody
                each z in zeilen
                  - const o = z.ort
                  - const einrueckung = { 1: null, 2: 'ps-4', 4: 'ps-5', 6: 'ps-5' }[z.ebene]
                  - const ebene = { 4: 'Träger', 6: 'Wache' }[z.ebene]
                  - const lat = o ? o.lat : z.auto_lat
                  - const lon = o ? o.lon : z.auto_lon
                  tr(class=z.ebene === 1 ? 'table-active' : null)
                    td(class=[einrueckung, z.ebene === 1 ? 'fw-semibold' : null])
                      if ebene
                        span.small.text-body-secondary.me-2= ebene
                      | #{(o && o.name) || z.name}
                    td.text-end.font-monospace.text-body-secondary= z.nr
                    td.font-monospace(class=o ? null : 'text-body-secondary')
                      if lat && lon
                        | #{Number(lat).toFixed(5)}, #{Number(lon).toFixed(5)}
                      else
                        span.text-warning keine
                    if o && o.warncell_id
                      td.font-monospace= o.warncell_id
                    else
                      td.text-body-secondary aus Koordinate
                    td
                      if o
                        i.bi.bi-geo-alt-fill.me-2.text-info(aria-hidden='true')
                        | eigener Eintrag
                      else
                        span.text-body-secondary Mittelpunkt der Wachen
                    td.text-end.text-nowrap
                      button.btn.btn-sm.btn-link.text-body-secondary.wetter-test(type='button', data-nr=z.nr, title='Wetter und Warnungen abrufen', aria-label='Wetter für ' + z.nr + ' abrufen')
                        i.bi.bi-eye(aria-hidden='true')
                      button.btn.btn-sm.btn-link.text-body(type='button', data-ort=z.nr, data-id=o ? o.id : '', data-name=o ? o.name : '', data-auto-name=z.name, data-lat=o ? o.lat : '', data-lon=o ? o.lon : '', data-auto-lat=z.auto_lat || '', data-auto-lon=z.auto_lon || '', data-zelle=o && o.warncell_id ? o.warncell_id : '', title='Standort bearbeiten', aria-label='Standort ' + z.nr + ' bearbeiten')
                        i.bi.bi-pencil(aria-hidden='true')

  #ortModal.modal.fade(tabindex='-1', aria-labelledby='ortTitel', aria-hidden='true')
    .modal-dialog.modal-dialog-centered.modal-lg
      .modal-content
        .modal-header
          h2#ortTitel.modal-title.h5 Standort
          button.btn-close(type='button', data-bs-dismiss='modal', aria-label='Schließen')
        .modal-body
          form#ortForm(action='/adm_edit_wetter/edit', method='post')
            input(type='hidden', name='_csrf', value=csrf_token)
            input#ort_id(type='hidden', name='id')
            .row.g-2
              .col-4.col-md-3
                label.form-label(for='ort_nr') Nummer
                input#ort_nr.form-control(type='text', name='nr', inputmode='numeric', maxlength='6')
              .col-8.col-md-9
                label.form-label(for='ort_name') Bezeichnung
                input#ort_name.form-control(type='text', name='name', maxlength='100')
              .col-6.col-md-4
                label.form-label(for='ort_lat') Breite (Lat)
                input#ort_lat.form-control(type='text', name='lat', inputmode='decimal', pattern='-?\\d{1,2}([.,]\\d+)?')
              .col-6.col-md-4
                label.form-label(for='ort_lon') Länge (Lon)
                input#ort_lon.form-control(type='text', name='lon', inputmode='decimal', pattern='-?\\d{1,3}([.,]\\d+)?')
              .col-12.col-md-4
                label.form-label(for='ort_zelle') Warnzelle
                input#ort_zelle.form-control(type='text', name='warncell_id', inputmode='numeric', pattern='\\d{6,10}', placeholder='aus Koordinate')
              .col-12
                #ort_karte.rounded.border.mt-1(style='height: 280px')
            #ort_hilfe.form-text.mt-2
          form#ortLoeschen(action='/adm_edit_wetter/delete', method='post')
            input(type='hidden', name='_csrf', value=csrf_token)
            input#ort_loeschen_id(type='hidden', name='id')
        .modal-footer
          button#ort_loeschen.btn.btn-outline-danger.me-auto(type='submit', form='ortLoeschen')
            i.bi.bi-arrow-counterclockwise.me-1(aria-hidden='true')
            | Eigenen Eintrag löschen
          button.btn.btn-secondary(type='button', data-bs-dismiss='modal') Abbrechen
          button.btn.btn-primary(type='submit', form='ortForm') Speichern

  //- Ergebnis des Tests (Auge) als eigener Dialog
  #test_karte.modal.fade(tabindex='-1', aria-labelledby='test_titel', aria-hidden='true')
    .modal-dialog.modal-dialog-centered.modal-lg
      .modal-content
        .modal-header
          h2.modal-title.h5.d-flex.align-items-center.gap-2
            i.bi.bi-eye(aria-hidden='true')
            span#test_titel Test
          button.btn-close(type='button', data-bs-dismiss='modal', aria-label='Schließen')
        .modal-body
          #test_inhalt.d-flex.flex-wrap.gap-3.text-body-secondary
        .modal-footer
          button.btn.btn-secondary(type='button', data-bs-dismiss='modal') Schließen

  script#wetter_daten(type='application/json')!= JSON.stringify({ csrf: csrf_token, aktiv: wetter_aktiv, waldbrand: Boolean(waldbrand_url) }).replace(/</g, '\\u003c')
  script.
    (function () {
      const daten = JSON.parse(document.getElementById("wetter_daten").textContent);
      const karte = document.getElementById("test_karte");
      const titel = document.getElementById("test_titel");
      const inhalt = document.getElementById("test_inhalt");
      const status = document.getElementById("wetter_status");
      const STUFEN = { 1: ["Wetterwarnung", "text-bg-warning"], 2: ["Markante Wetterwarnung", "text-bg-warning"], 3: ["Unwetterwarnung", "text-bg-danger"], 4: ["Extremes Unwetter", "text-bg-danger"] };
      const SYMBOLE = { "clear-day": "klar", "clear-night": "klar", "partly-cloudy-day": "teils bewölkt", "partly-cloudy-night": "teils bewölkt", cloudy: "bewölkt", fog: "Nebel", wind: "windig", rain: "Regen", sleet: "Schneeregen", snow: "Schnee", hail: "Hagel", thunderstorm: "Gewitter" };

      function eintrag(text, klasse) {
        const span = document.createElement("span");
        if (klasse) span.className = klasse;
        span.textContent = text;
        return span;
      }

      function status_setzen(ok, text, element) {
        const el = element || status;
        el.className = "badge align-self-center " + (ok ? "text-bg-success" : "text-bg-danger");
        el.textContent = text;
      }

      async function testen(nr) {
        bootstrap.Modal.getOrCreateInstance(karte).show();
        titel.textContent = "Test: " + nr + " …";
        inhalt.replaceChildren(eintrag("wird abgerufen …"));
        try {
          const res = await fetch("/adm_edit_wetter/test", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ _csrf: daten.csrf, nr: nr }),
          });
          const r = await res.json();
          if (!res.ok) throw new Error(r.error || "HTTP " + res.status);
          status_setzen(true, "erreichbar");
          titel.textContent = "Test: " + nr + (String(r.ort.nr) !== String(nr) ? " → " + r.ort.nr : "") + " · " + (r.ort.name || "") + (r.ort.quelle === "wachen" ? " (aus Wachen-Stammdaten)" : "");
          const a = r.aktuell || {};
          const teile = [
            eintrag("Quelle: " + (r.aktuell_quelle || "–")),
            eintrag((a.temperatur ?? "–") + " °C" + (a.icon ? ", " + (SYMBOLE[a.icon] || a.icon) : "")),
            eintrag("Wind " + (a.wind ?? "–") + " km/h, Böen " + (a.boeen ?? "–") + " km/h"),
            eintrag("Koordinate " + Number(r.ort.lat).toFixed(5) + ", " + Number(r.ort.lon).toFixed(5)),
            eintrag("Warngebiet: " + ((r.warnungen && r.warnungen.gebiet) || "–")),
            eintrag("Antwort in " + r.dauer_ms + " ms"),
          ];
          const liste = (r.warnungen && r.warnungen.liste) || [];
          if (r.waldbrand && r.waldbrand.fehler) teile.push(eintrag("Waldbrand: " + r.waldbrand.fehler, "text-danger"));
          else if (r.waldbrand) teile.push(eintrag("Waldbrandgefahr Stufe " + r.waldbrand.stufe + " (" + r.waldbrand.gebiet + ", " + r.waldbrand.datum + ")" + (r.waldbrand.stufe >= r.waldbrand_ab ? " – wird angezeigt" : " – unter Anzeigeschwelle " + r.waldbrand_ab), "badge align-self-center " + (r.waldbrand.stufe >= r.waldbrand_ab ? "text-bg-warning" : "text-bg-secondary")));
          if (liste.length === 0) teile.push(eintrag("keine Warnungen", "badge text-bg-success align-self-center"));
          liste.forEach(function (w) {
            const s = STUFEN[w.stufe] || STUFEN[1];
            teile.push(eintrag(s[0] + ": " + w.ereignis, "badge align-self-center " + s[1]));
          });
          inhalt.replaceChildren.apply(inhalt, teile);
        } catch (e) {
          status_setzen(false, "Fehler");
          titel.textContent = "Test: " + nr;
          inhalt.replaceChildren(eintrag(e.message, "text-danger"));
        }
      }

      // Status von Bright Sky und Waldbrand-Dienst beim Laden der Seite prüfen
      const wb_status = document.getElementById("waldbrand_status");
      const dienst_anzeigen = function (d, el) {
        if (!d || !d.aktiv) return status_setzen(false, "nicht eingerichtet", el);
        status_setzen(d.ok, d.ok ? "erreichbar (" + d.dauer_ms + " ms" + (d.datum ? ", Stand " + d.datum : "") + ")" : "nicht erreichbar", el);
        if (!d.ok) el.title = d.fehler || "";
      };
      fetch("/adm_edit_wetter/status", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ _csrf: daten.csrf }),
      })
        .then(function (res) { return res.json(); })
        .then(function (r) { dienst_anzeigen(r.brightsky, status); dienst_anzeigen(r.waldbrand, wb_status); })
        .catch(function () { status_setzen(false, "nicht erreichbar"); status_setzen(false, "nicht erreichbar", wb_status); });

      // Bearbeiten und Anlegen im Dialog
      const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById("ortModal"));
      const feld = (id) => document.getElementById(id);
      const ort_karte = admin_karte(feld("ort_karte"), !{JSON.stringify(map_service)}, { lat: feld("ort_lat"), lon: feld("ort_lon") });
      let auto_punkt = [null, null];
      feld("ortModal").addEventListener("shown.bs.modal", () => ort_karte.zeigen(auto_punkt[0], auto_punkt[1]));
      function oeffnen(d) {
        const form = feld("ortForm");
        form.reset();
        const vorhanden = Boolean(d && d.id);
        const neu_genau = !d;
        form.action = vorhanden ? "/adm_edit_wetter/edit" : "/adm_edit_wetter/create";
        feld("ortTitel").textContent = neu_genau ? "Standort für Träger oder Wache" : "Standort " + d.ort + " · " + (d.name || d.autoName);
        feld("ort_id").value = vorhanden ? d.id : "";
        feld("ort_loeschen_id").value = vorhanden ? d.id : "";
        feld("ort_loeschen").classList.toggle("d-none", !vorhanden);
        const nr = feld("ort_nr");
        nr.value = d ? d.ort : "";
        nr.readOnly = !neu_genau;
        nr.className = neu_genau ? "form-control" : "form-control-plaintext font-monospace";
        nr.required = neu_genau;
        nr.pattern = neu_genau ? "\\d{4}|\\d{6}" : ".*";
        nr.placeholder = neu_genau ? "4 oder 6 Ziffern" : "";
        feld("ort_name").value = d ? d.name : "";
        feld("ort_name").placeholder = d && d.autoName ? d.autoName : "leer = aus den Wachen übernehmen";
        feld("ort_lat").value = d ? d.lat : "";
        feld("ort_lon").value = d ? d.lon : "";
        feld("ort_lat").placeholder = d && d.autoLat ? d.autoLat : "leer = Wachen";
        feld("ort_lon").placeholder = d && d.autoLon ? d.autoLon : "leer = Wachen";
        feld("ort_lat").required = vorhanden;
        feld("ort_lon").required = vorhanden;
        feld("ort_zelle").value = d ? d.zelle : "";
        feld("ort_hilfe").textContent = vorhanden
          ? "Punkt ziehen oder in die Karte klicken (blau). Grau gestrichelt: Mittelpunkt der Wachen, der ohne eigenen Eintrag gilt."
          : "Punkt ziehen oder in die Karte klicken. Leere Koordinaten = Mittelpunkt der Wachen (grau gestrichelt), z.B. wenn nur eine feste Warnzelle gesetzt werden soll.";
        auto_punkt = d ? [d.autoLat, d.autoLon] : [null, null];
        modal.show();
      }
      document.querySelectorAll("[data-ort]").forEach((btn) => btn.addEventListener("click", () => oeffnen(btn.dataset)));
      document.querySelector("[data-ort-neu]").addEventListener("click", () => oeffnen(null));
      feld("ort_loeschen").addEventListener("click", function (ev) {
        if (!confirm("Eigenen Standort " + feld("ort_nr").value + " löschen? Danach gilt wieder der Mittelpunkt der Wachen bzw. der übergeordnete Eintrag.")) ev.preventDefault();
      });

      document.querySelectorAll(".wetter-test").forEach(function (btn) {
        btn.addEventListener("click", function () { testen(btn.dataset.nr); });
      });
      document.getElementById("test_nr_form").addEventListener("submit", function (ev) {
        ev.preventDefault();
        const nr = document.getElementById("test_nr").value.trim();
        if (nr) testen(nr);
      });
    })();
