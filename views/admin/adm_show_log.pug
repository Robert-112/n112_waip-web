extends ../layout

append head
  link(rel='stylesheet', href='/css/dataTables.bootstrap5.min.css')
  script(src='/js/datatables.min.js')
  script(src='/js/dataTables.bootstrap5.min.js')

block content
  main(role='main')
    .container-fluid
      .row
        .col-12
          h3 Es werden die letzten 5.000 Einträge der Log-Datei angezeigt
        .col-12        
          .table-responsive
            table#table_log.table.table-striped.table-bordered.table-hover.table-sm.w-100
              thead
                tr
                  th ID
                  th Zeitstempel
                  th Typ
                  th Protokolltext

  script.
    let datasets = !{JSON.stringify(dataSet).replace(/<\//g, '<\\/')}
    $(document).ready(function() {
      $('#table_log').DataTable( {
        "data": datasets,
        "language": { 
          "url": "/js/datatables_german.json" 
        },
        "order": [
          [ 0, "desc" ]
        ],
        "iDisplayLength": 25,
        // alle Werte als Text ausgeben (DataTables fügt Inhalte sonst als HTML ein)
        "columnDefs": [{ "targets": "_all", "render": $.fn.dataTable.render.text() }],
        "columns": [
          { "data": "id" },
          { "data": "log_time" },
          { "data": "log_typ" },
          { "data": "log_text" }
        ]
      });
    });
