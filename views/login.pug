extends layout

block content
  main(role='main')
    .container
      .row.justify-content-center
        .col-12.col-sm-10.col-md-7.col-lg-5.col-xl-4
          .text-center.mt-4.mb-4
            .display-6.text-info.mb-2
              i.bi.bi-person-circle(aria-hidden='true')
            h1.h3.mb-1 Anmelden
            p.text-body-secondary.mb-0 Die Zugangsdaten erhalten Sie von den Administratoren.
          +meldungen(error, success)
          .card.border-0
            .card-body.p-4
              form(action='/login', method='POST')
                input(type="hidden" name="_csrf" value=csrf_token)
                .mb-3
                  label.form-label(for='login-user') Benutzername
                  input#login-user.form-control(type='text' name='user' autocomplete='username' placeholder='Benutzername eingeben' required='' autofocus='')
                .mb-3
                  label.form-label(for='login-password') Passwort
                  input#login-password.form-control(type='password' name='password' autocomplete='current-password' placeholder='Passwort' required='')
                .form-check.form-switch.mb-4
                  input#rembemerme.form-check-input(type='checkbox' role='switch' name='rememberme' checked='')
                  label.form-check-label(for='rembemerme') Anmeldung dauerhaft speichern
                button.btn.btn-primary.btn-lg.w-100(type='submit')
                  i.bi.bi-box-arrow-in-right.me-2(aria-hidden='true')
                  | Anmelden
          // Geräteanmeldung per Zertifikat (MDM-verwaltete Endgeräte) als Alternative
          .d-flex.align-items-center.gap-3.my-4.text-body-secondary
            hr.flex-grow-1.my-0
            span.small oder
            hr.flex-grow-1.my-0
          form(action='/login_cert', method='GET')
            button.btn.btn-outline-light.w-100(type='submit')
              i.bi.bi-shield-lock.me-2(aria-hidden='true')
              | Mit Gerätezertifikat anmelden
          p.form-text.text-center.mt-2.mb-4
            | Für zentral per MDM (Mobile-Device-Management) verwaltete Endgeräte – ohne Benutzername und Kennwort.
            | Die Berechtigung wird über das Zertifikat geprüft.
