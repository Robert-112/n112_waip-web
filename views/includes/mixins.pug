//- Gemeinsame Bausteine für die normalen Seiten (nicht für den Alarmmonitor)

//- Seitenkopf: Titel linksbündig, optional mit Icon und Untertitel
mixin seitenkopf(titel, untertitel, icon)
  .d-flex.align-items-center.gap-3.mt-3.mb-4
    if icon
      .fs-2.lh-1.text-info
        i.bi(class=icon, aria-hidden='true')
    div
      h1.h3.mb-1= titel
      if untertitel
        p.text-body-secondary.mb-0= untertitel

//- Rückmeldung nach Formularaktionen (Fehler/Erfolg), schließbar
mixin meldungen(error, success)
  if error
    .alert.alert-danger.alert-dismissible.d-flex.align-items-start.gap-2(role='alert')
      i.bi.bi-x-circle-fill.flex-shrink-0(aria-hidden='true')
      div= error
      button.btn-close(type='button', data-bs-dismiss='alert', aria-label='Schließen')
  if success
    .alert.alert-success.alert-dismissible.d-flex.align-items-start.gap-2(role='alert')
      i.bi.bi-check-circle-fill.flex-shrink-0(aria-hidden='true')
      div= success
      button.btn-close(type='button', data-bs-dismiss='alert', aria-label='Schließen')

//- Kachel mit farbigem Akzent links (Startseite, Alarmmonitor-Auswahl);
//- Inhalt per block, Aktion (Button/Dropdown) am unteren Rand
mixin kachel(titel, farbe, icon)
  .card.h-100.border-0.border-start.border-4(class='border-' + farbe)
    .card-body.d-flex.flex-column
      h2.h5.card-title.d-flex.align-items-center.gap-2(class='text-' + farbe)
        if icon
          i.bi(class=icon, aria-hidden='true')
        span= titel
      block

//- Hinweis zu den erlaubten Kalender-Servern (Einstellungen, Benutzerverwaltung)
mixin kalender_hinweis(aktiv, erlaubt)
  if !aktiv
    .form-text Auf diesem Server sind Kalender und Ticker nicht eingerichtet.
  else if erlaubt && erlaubt.length > 0
    .alert.alert-info.small.d-flex.align-items-start.gap-2.mb-0(role='note')
      i.bi.bi-info-circle-fill.flex-shrink-0(aria-hidden='true')
      div
        div.mb-1
          | Aus Sicherheitsgründen sind nur Kalender von diesen Servern erlaubt:
          each d in erlaubt
            span.badge.text-bg-light.border.ms-1.font-monospace= d
        div
          | Andere Kalender können auf Anfrage und nach Prüfung durch den Betreiber des Wachalarm IP-Web freigegeben werden.
          | Es werden nur öffentliche Kalender ohne Login unterstützt.
          | Neue Adressen werden beim Speichern geprüft und einmal probeweise geladen.
  else
    .form-text.text-warning Der Kalender-Dienst ist derzeit nicht erreichbar oder es sind keine Kalender freigegeben.

//- Verbindungsstatus einer gespeicherten Kalender-Adresse, wird per /js/kalender_status.js nachgeladen
mixin kalender_status(feld)
  .form-text.d-none(data-kalender-status=feld, aria-live='polite')
