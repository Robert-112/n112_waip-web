.row
  .col-12.d-flex.justify-content-between.flex-wrap.pb-2
    .d-flex.justify-content-start
      .text-secondary Alarmierungszeit: &nbsp;
      #einsatz_datum.text-muted &nbsp;-Datum-
    .d-flex.justify-content-end
      .text-secondary Einsatznummer: &nbsp;
      #dbrd_id.bi-clipboard.text-muted -Nummer-
.row
  .col-lg-4.col-12
    #einsatz_art.row.g-0.bg-secondary.rounded.p-3
      .col-10
        .align-items-center.fw-bold
          #einsatz_stichwort.fw-bold.bi-grid-3x3-gap-fill  -Stichwort-
      .col-2
        .align-items-center.justify-content-center.rounded.text-center
          #sondersignal.fw-bold.bi-grid-3x3-gap-fill
    div.border-top.m-3
    .row
      .col-lg-12.col-md-6.col-12
        .card.mt-2
          .card-body.p-0
            #map.rounded(style={height: '30em'})
        div.border-top.m-3.d-md-none.d-lg-block
      .col-lg-12.col-md-6.col-12
        .card.mt-2
          .card-header.bg-dark.px-3.py-2
            .text-info.fw-bold.mb-0 Einsatzort
          .card-body.p-0
            ul#einsatzort_list.list-group.list-group-flush
    div.border-top.m-3.d-lg-none.d-xl-none.d-md-block
  .col-lg-8.col-12
    .row.g-0
      .col-12
        .card
          table#table_einsatzmittel.table.table-hover.mb-0
            thead.table-borderless.small
              tr
                th.wache-col.text-info.ps-3 Wache
                th.text-info.ps-3 alarmierte Einsatzmittel / Rückmeldungen
            tbody
              // Dynamische Zeilen werden per JS eingefügt
        div.border-top.m-3
      .col-12
        div#rmld_container
          .card#rmld_container.mb-3
            .card-header.bg-dark.px-3.py-2
              .text-info.fw-bold.mb-0 Anzahl aller Rückmeldungen
            .card-body.py-2.px-3
              .d-flex.flex-wrap.align-items-start
                .d-flex.align-items-center.border.border-secondary.rounded-pill.px-1.py-2.me-2.mb-1 
                  span.mx-1 Gesamt
                  span#gs-counter.me-1.badge.bg-primary 0
                .d-flex.align-items-center.flex-wrap.border.border-secondary.rounded-pill.px-1.py-2.me-2.mb-1 
                  span.me-2.ms-1.text-success EK
                  span#ek-counter.badge.bg-success.me-3 0
                  span.me-2.text-info GF
                  span#gf-counter.badge.bg-info.me-3 0
                  span.me-2.text-light ZF
                  span#zf-counter.badge.bg-light.text-dark.me-3 0
                  span.me-2.text-danger VF
                  span#vf-counter.me-1.badge.bg-danger 0
                .d-flex.align-items-center.flex-wrap.border.border-secondary.rounded-pill.px-1.py-2.me-2.mb-1 
                  span.me-2.ms-1.text-warning AGT
                  span#agt-counter.badge.bg-warning.me-3 0
                  span.me-2.text-muted MA
                  span#ma-counter.badge.bg-primary.me-3 0
                  span.me-2.text-muted FZF
                  span#fzf-counter.badge.bg-primary.me-3 0
                  span.me-2.text-muted MED
                  span#med-counter.badge.bg-primary.me-1 0
.d-none
  audio#audio(controls='')
      source(src='', type='audio/mpeg')
// Vollbild-Kartenmodal
#mapModal.modal.fade(tabindex='-1' role='dialog')
  .modal-dialog.modal-dialog-centered.modal-xl(role='document')
    .modal-content.bg-dark
      .modal-header.py-2.border-secondary
        h5.modal-title.text-light.mb-0 Einsatzkarte
        button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Schließen')
      .modal-body.p-0
        #map_fullscreen(style='height:80vh;')

