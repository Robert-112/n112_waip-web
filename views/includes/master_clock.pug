#waipclock.fullheight
  #screen_saver.h-95
    //- Uhr, Gefahrenhinweise und Widgets bilden einen Block, der als Ganzes wandert (Einbrennschutz).
    //- Querformat: links Uhr + Gefahren, rechts Wetter + Termine; Hochformat: untereinander (siehe waip.css)
    #standby_block
      #standby_links
        #clock_day
          #time.text-muted.fw-bold.d-flex.align-items-end.clock_frame
            span#clock-hhmm -HH:MM-
            span#clock-seconds.clock-seconds :00
          #day.text-secondary.d-flex.align-items-start.day_frame -Datum-
        #standby_gefahren.d-none
          #standby_warnung.standby-gefahr.d-none(role='status')
            i.bi.bi-exclamation-triangle-fill(aria-hidden='true')
            .standby-gefahr-text
              .standby-gefahr-art
              .standby-gefahr-titel
              .standby-gefahr-info
          #standby_waldbrand.standby-gefahr.d-none(role='status')
            i.bi.bi-fire(aria-hidden='true')
            .standby-gefahr-text
              .standby-gefahr-art
              .standby-gefahr-titel
              .standby-gefahr-info
      #standby_widgets.d-none
        #standby_wetter.d-none
          .standby-wetter-jetzt
            i.bi.standby-wetter-icon(aria-hidden='true')
            .standby-wetter-temp
            .standby-wetter-minmax
          .standby-wetter-tage
          .standby-quelle.standby-wetter-quelle
            span.standby-wetter-stand
            //- Bootstrap-Tooltip (der title-Tooltip erscheint in Safari verzögert, auf iPad/iPhone gar nicht)
            span.standby-quelle-dwd(tabindex='0', data-bs-toggle='tooltip', data-bs-title='Quelle: Deutscher Wetterdienst', aria-label='Quelle: Deutscher Wetterdienst')
              i.bi.bi-c-circle(aria-hidden='true')
              | &nbsp;DWD
        #standby_kalender.d-none
          .standby-kalender-kopf
            span.standby-label
              i.bi.bi-calendar-event(aria-hidden='true')
              span Termine
            span.standby-quelle.standby-kalender-stand
          .standby-kalender-liste
  .h-5.pt-2
    #wachenname_footer.text-secondary
      .h4.bi-building
        = ' ' + (data_wache || ' -Wachenname-')
        span#wachenname-login-icon.bi-eye-slash.d-none(title="Nicht angemeldet")
