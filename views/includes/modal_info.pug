// Modal
#waipModal.modal.fade(tabindex='-1', role='dialog', aria-hidden='true')
  .modal-dialog.modal-dialog-centered(role='document')
    .modal-content
      .modal-header
        h5#waipModalTitle.modal-title Modal Titel
        button.btn-close(type='button', data-bs-dismiss='modal', aria-label='Schließen')
      #waipModalBody.modal-body
        | ...
      .modal-footer
        button.btn.btn-secondary(type='button', data-bs-dismiss='modal') Schließen
