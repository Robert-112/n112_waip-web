//- Menüpunkt; aktiv = dezent hinterlegt (auch im aufgeklappten Mobil-Menü erkennbar)
mixin navlink(href, text, icon, aktiv)
  li.nav-item
    a.nav-link.text-nowrap.rounded.px-2.px-lg-3(href=href, class=aktiv ? 'active bg-white bg-opacity-10' : null, aria-current=aktiv ? 'page' : null)
      i.bi.me-1(class=icon, aria-hidden='true')
      | #{text}

- const seite = title || ''
- const istInfo = ['Impressum', 'Datenschutzerklärung', 'Über'].includes(seite)
- const istAdmin = ['Benutzer und Rechte verwalten', 'Wachen verwalten', 'Ersetzungen verwalten', 'Verbundene PCs/Benutzer', 'Akutelle Einsätze', 'Log-Datei'].includes(seite)

header
  // Fixed navbar
  nav.navbar.navbar-expand-lg.bg-primary.fixed-top(data-bs-theme='dark')
    .container-fluid
      a.navbar-brand(href='/')= public.app_name
      button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarCollapse', aria-controls='navbarCollapse', aria-expanded='false', aria-label='Menü umschalten')
        span.navbar-toggler-icon
      #navbarCollapse.collapse.navbar-collapse
        ul.navbar-nav.me-auto.gap-lg-1
          +navlink('/', 'Startseite', 'bi-house-door-fill', seite == public.app_name || seite == 'Startseite')
          +navlink('/waip', 'Alarmmonitor', 'bi-display', seite.startsWith('Alarmmonitor'))
          +navlink('/dbrd', 'Dashboard', 'bi-clipboard', seite.startsWith('Dashboard'))
        ul.navbar-nav.ms-auto.align-items-lg-center.gap-lg-1
          li.nav-item.dropdown
            a#navbarWeiteresDropdown.nav-link.dropdown-toggle.text-nowrap.rounded.px-2.px-lg-3(href='#', role='button', data-bs-toggle='dropdown', aria-expanded='false', class=istInfo ? 'active bg-white bg-opacity-10' : null)
              i.bi.bi-info-circle.me-1(aria-hidden='true')
              | Info
            .dropdown-menu.dropdown-menu-lg-end(aria-labelledby='navbarWeiteresDropdown')
              a.dropdown-item(href='/impressum') Impressum
              a.dropdown-item(href='/datenschutz') Datenschutzerkl&auml;rung
              .dropdown-divider
              a.dropdown-item(href='/ueber') &Uuml;ber diese Anwendung
          if user
            if user.permissions == 'admin'
              li.nav-item.dropdown
                a#navbarAdminDropdown.nav-link.dropdown-toggle.text-nowrap.rounded.px-2.px-lg-3(href='#', role='button', data-bs-toggle='dropdown', aria-expanded='false', class=istAdmin ? 'active bg-white bg-opacity-10' : null)
                  i.bi.bi-wrench.me-1(aria-hidden='true')
                  | Administration
                .dropdown-menu.dropdown-menu-lg-end(aria-labelledby='navbarAdminDropdown')
                  a.dropdown-item(href='/adm_edit_users')
                    i.bi.bi-people-fill.me-2(aria-hidden='true')
                    | Benutzer und Rechte verwalten
                  a.dropdown-item(href='/adm_edit_wachen')
                    i.bi.bi-building.me-2(aria-hidden='true')
                    | Wachen bearbeiten
                  a.dropdown-item(href='/adm_edit_replace')
                    i.bi.bi-arrow-left-right.me-2(aria-hidden='true')
                    | Ersetzungen bearbeiten
                  .dropdown-divider
                  a.dropdown-item(href='/adm_show_clients')
                    i.bi.bi-globe.me-2(aria-hidden='true')
                    | Verbundene PCs und Benutzer anzeigen
                  a.dropdown-item(href='/adm_show_missions')
                    i.bi.bi-list-ul.me-2(aria-hidden='true')
                    | laufende Eins&auml;tze anzeigen
                  .dropdown-divider
                  a.dropdown-item(href='/adm_show_log')
                    i.bi.bi-journal-text.me-2(aria-hidden='true')
                    | Log-Datei einsehen
            +navlink('/einstellungen', 'Einstellungen', 'bi-gear-fill', seite == 'Einstellungen')
            li.nav-item.ms-lg-2.mt-2.mt-lg-0
              form(action='/logout', method='POST')
                input(type="hidden" name="_csrf" value=csrf_token)
                button.btn.btn-sm.btn-dark.text-nowrap(type='submit', title='Abmelden')
                  i.bi.bi-box-arrow-right.me-1(aria-hidden='true')
                  | #{user.user} abmelden
          else
            // login nur anzeigen, wenn aktiviert
            if public.show_login
              +navlink('/login', 'Anmelden', 'bi-box-arrow-in-right', seite == 'Login')
