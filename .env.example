# -------------------------------------------------------
# Allgemeine Server-Einstellungen
# -------------------------------------------------------
HTTP_PORT=3001
DATABASE=./database.sqlite3
DB_LIMIT=500
DB_LIMIT_LOG=100000
SOUNDPATH=/public/media/
MEDIAPATH=/media/
UUID_NAMESPACE=59cc72ec-4ff5-499d-81e2-ec49c1d01252
TIME_TO_DELETE_WAIP=30
DEFAULT_TIME_FOR_STANDBY=15
SYSTEM_CLEANUP_TIME=10000

# Standard-Admin / Standard-API-Nutzer (nur beim ersten Start verwendet)
DEFAULT_USER=me
DEFAULT_PASS=CHANGE_ME
DEFAULT_API_USER=apiuser
DEFAULT_API_PASS=CHANGE_ME
DEFAULT_USER_IP=127.0.0.1

# Sicherheit
SALT_ROUNDS=10
SESSION_SECRET=CHANGE_ME_long_random_string
JWT_SECRET=CHANGE_ME_long_random_string
SESSION_COOKIE_MAX_AGE=60000

# Regex fuer Zertifikats-Authentifizierung
AUTH_REGEX=(\d+)[.\-](\d+)[.\-](\w+)
RIGHTS_REGEX=\.(\d+)[.-]

# -------------------------------------------------------
# Entwicklungs-Einstellungen
# -------------------------------------------------------
DEV_LOG=false
DEV_SQLITE=false

# -------------------------------------------------------
# Strukturiertes Log (JSON/ECS) z.B. fuer Filebeat -> Elasticsearch
# -------------------------------------------------------
# Datei fuer Sicherheits- und Stabilitaetsereignisse, leer = aus (siehe elastic/README.md)
LOG_JSON_FILE=
# Intervall in Sekunden fuer Kennzahlen (Speicher, Event-Loop, Clients), 0 = aus
LOG_METRICS_INTERVAL=60

# -------------------------------------------------------
# Erscheinung / Oeffentliche Einstellungen
# -------------------------------------------------------
PUBLIC_URL=https://your-domain.example.com
APP_NAME=Wachalarm IP-Web
APP_INFO=
COMPANY=Ihr Firmenname

# Karte: "tile" fuer Tile-Server, "wms" fuer WMS-Server (mit Tile-Server als Fallback)
MAP_SERVICE_TYPE=tile
MAP_TILE_URL=https://{s}.tile.openstreetmap.de/{z}/{x}/{y}.png
MAP_WMS_URL=
MAP_WMS_LAYERS=OSM-WMS
MAP_WMS_FORMAT=image/png
MAP_WMS_TRANSPARENT=true
MAP_WMS_VERSION=1.1.1

# Impressum / Datenschutz (externes Impressum / Datenschutz aktivieren)
EXT_IMPRINT=false
URL_IMPRINT=https://your-domain.example.com/impressum
EXT_PRIVACY=false
URL_PRIVACY=https://your-domain.example.com/datenschutz

SHOW_LOGIN=true

# Netzkopplungspruefung: Test-URLs (kommagetrennt), gegen die der Alarmmonitor-Client
# regelmaessig prueft, ob er (unzulaessig) Internet-Zugriff hat. Sollten auf eine
# Bild-Ressource zeigen (z.B. favicon.ico), da die Pruefung per Image-Load erfolgt.
# Schon eine erreichbare Adresse gilt als Verdacht ("Teilweise", wenn nicht alle erreichbar sind).
NETZKOPPLUNG_CHECK_URLS=https://www.google.com/favicon.ico,https://www.heise.de/favicon.ico

# -------------------------------------------------------
# OSRM Routing (Routen von Wachen zum Einsatzort)
# -------------------------------------------------------
# OSRM aktivieren (true/false)
OSRM_ENABLED=false
# Hostname/IP des OSRM-Containers
OSRM_HOST=localhost
# HTTP-Port des OSRM-Containers
OSRM_PORT=5000

# -------------------------------------------------------
# Text-to-Speech (TTS)
# -------------------------------------------------------
# Provider: "local" (plattformspezifisch, Standard) oder "piper" (Piper-Docker)
TTS_PROVIDER=local

# Piper-Einstellungen (nur relevant wenn TTS_PROVIDER=piper)
# Hostname/IP des Piper-Containers
PIPER_HOST=localhost
# Wyoming-Protokoll-Port des Piper-Containers
PIPER_PORT=10200
# Stimme im Piper-Format (Modell muss im Container unter /models verfügbar sein)
PIPER_VOICE=de_DE-thorsten_emotional-medium

# -------------------------------------------------------
# Standby-Widgets (Wetter, Unwetterwarnungen, Kalender)
# -------------------------------------------------------
# Die Daten holt nur der Server, die Alarmmonitore brauchen kein Internet.
# Jeder Benutzer schaltet Wetter/Kalender unter "Einstellungen" selbst ein.
#
# Adresse des selbst gehosteten Bright Sky (DWD-Daten), leer = kein Wetter
WIDGET_BRIGHTSKY_URL=
# Aktuelles Wetter je Monitor alle x Minuten senden (Startzeitpunkt je Monitor zufällig verteilt)
WIDGET_WEATHER_INTERVAL=30
# Unwetterwarnungen alle x Minuten prüfen, Änderungen gehen sofort an alle Monitore
WIDGET_ALERT_INTERVAL=5
# Daten, die älter als x Minuten sind, blendet der Monitor aus (z.B. Bright Sky gestört)
WIDGET_MAX_AGE=180
# Kalender alle x Minuten neu laden
WIDGET_ICAL_INTERVAL=15
# Termine von heute bis heute + x Tage, höchstens WIDGET_ICAL_MAX Einträge
WIDGET_ICAL_DAYS=3
WIDGET_ICAL_MAX=4
# Maximale Größe einer Kalender-Datei in KB
WIDGET_ICAL_MAX_KB=2048
# Proxy für Kalender-Server mit Kennzeichen ":proxy" (benötigt Node.js >= 24.5)
WIDGET_ICAL_PROXY=
# Erlaubte Kalender-Server (exakter Hostname, nur HTTPS/443), kommagetrennt, je Server ":proxy" oder ":direkt"
# Beispiel: cloud.feuerwehr-beispiel.de:proxy,mail.intern.lan:direkt
WIDGET_ICAL_DOMAINS=
# Zeitzone für "heute"/"morgen"
WIDGET_TIMEZONE=Europe/Berlin
